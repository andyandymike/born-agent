{
  "name": "bornagent",
  "version": "0.0.0",
  "description": "A learning-first coding agent built one phase at a time.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "capabilities",
    "fixtures/capability-platform/m9-review-pack",
    "evals",
    "policies",
    "docker/artifacts"
  ],
  "bin": {
    "born": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": "11.13.1"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "eslint . && tsc -p tsconfig.json --noEmit && vitest run && node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "session:validate": "node scripts/validate-latest-session.mjs",
    "phase4:validate": "node scripts/validate-phase-04-session.mjs",
    "pack:smoke": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/pack-smoke.mjs",
    "repository:baseline": "tsx src/repository-intelligence/benchmark/run-baseline-cli.ts",
    "repository:candidates": "tsx src/repository-intelligence/benchmark/run-candidates-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.7",
    "@earendil-works/pi-tui": "0.80.7",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.17.1",
    "commander": "15.0.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "node-pty": "1.1.0",
    "tsx": "4.23.1",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
