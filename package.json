{
  "name": "bornagent",
  "version": "0.0.0",
  "description": "A learning-first coding agent built one phase at a time.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "capabilities",
    "fixtures/capability-platform/m9-review-pack",
    "fixtures/task-orchestration/m10-durable-graph",
    "fixtures/controlled-subagents/m11-canonical",
    "evals",
    "policies",
    "docker/artifacts"
  ],
  "bin": {
    "born": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": "11.13.1"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "memory:baseline": "tsx src/memory/benchmark/run-agent-memory-baseline-cli.ts",
    "memory:validate": "tsx src/memory/benchmark/run-agent-memory-validate-cli.ts",
    "memory:working:benchmark": "tsx src/memory/benchmark/run-agent-memory-working-state-cli.ts",
    "memory:working:validate": "tsx src/memory/benchmark/run-agent-memory-working-state-validate-cli.ts",
    "test": "vitest run",
    "test:non-pty": "vitest run --exclude \"**/*pty.test.ts\"",
    "test:pty": "vitest run tests/integration/phase19e-tui-pty.test.ts --maxWorkers=1 && vitest run tests/integration/phase16f-tui-pty.test.ts --maxWorkers=1 && vitest run tests/integration/phase17e-tui-pty.test.ts --maxWorkers=1 && vitest run tests/integration/phase18d-hook-tui-pty.test.ts --maxWorkers=1 && vitest run tests/integration/phase18e-tui-pty.test.ts --maxWorkers=1 && vitest run tests/integration/phase20e-coding-tui-pty.test.ts --maxWorkers=1 && vitest run tests/integration/phase20e-tui-pty.test.ts --maxWorkers=1",
    "test:watch": "vitest",
    "phase21a:gate": "node scripts/validate-phase21a.mjs",
    "architecture:characterize": "node --import tsx tests/fixtures/architecture-characterization-cli.ts",
    "architecture:gate": "node scripts/validate-architecture-simplification.mjs",
    "architecture:report": "node scripts/write-architecture-command-report.mjs",
    "check": "eslint . && tsc -p tsconfig.json --noEmit && pnpm test:non-pty && pnpm test:pty && node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "session:validate": "node scripts/validate-latest-session.mjs",
    "phase4:validate": "node scripts/validate-phase-04-session.mjs",
    "pack:smoke": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/pack-smoke.mjs",
    "repository:baseline": "tsx src/repository-intelligence/benchmark/run-baseline-cli.ts",
    "repository:candidates": "tsx src/repository-intelligence/benchmark/run-candidates-cli.ts",
    "repository:cache:benchmark": "tsx src/repository-intelligence/benchmark/run-cache-benchmark-cli.ts",
    "repository:cache:compare": "tsx src/repository-intelligence/benchmark/run-cache-compare-cli.ts",
    "repository:cache:installed-smoke": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/pack-smoke.mjs --repository-cache-installed-smoke",
    "repository:cache:race": "tsx src/repository-intelligence/benchmark/run-cache-race-cli.ts",
    "repository:cache:validate": "tsx src/repository-intelligence/benchmark/run-cache-validate-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.7",
    "@earendil-works/pi-tui": "0.80.7",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.17.1",
    "commander": "15.0.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "node-pty": "1.1.0",
    "tsx": "4.23.1",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
