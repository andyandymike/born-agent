{
  "schema_version": 1,
  "id": "resume-checkpoint",
  "task_version": 1,
  "category": "resume-context",
  "prompt": "Recover from the durable boundary and create answer.txt containing exactly PASS:resume-checkpoint followed by a newline.",
  "initial_workspace_sha256": "3b499849b3810cde755cdc96a7700983dfde9ee1dc4672707ebaed8d85823b6e",
  "scenario": {
    "kind": "scripted_v1",
    "config": {
      "context_window_tokens": 4096,
      "executor": "docker_v1"
    },
    "services": [],
    "steps": [
      {
        "kind": "run",
        "id": "initial",
        "fault": {
          "hook": "after_checkpoint_created",
          "action": "terminate_once"
        }
      },
      {
        "kind": "resume",
        "id": "recover",
        "from": "initial"
      }
    ]
  },
  "allowed_changes": {
    "exact": [
      "answer.txt"
    ],
    "prefixes": [],
    "max_files": 1,
    "max_changed_lines": 10
  },
  "forbidden_changes": {
    "exact": [
      "TASK.md"
    ],
    "prefixes": [
      ".git/",
      ".bornagent/",
      "grader/"
    ]
  },
  "agent_commands": [],
  "acceptance": [
    {
      "id": "hidden-static",
      "kind": "static",
      "grader": {
        "executable": "node",
        "args": [
          "/grader/grade.mjs"
        ],
        "cwd": "/grader",
        "timeout_ms": 30000,
        "expected_exit": 0
      }
    }
  ],
  "limits": {
    "agent_duration_ms": 120000,
    "grader_duration_ms": 30000
  }
}
