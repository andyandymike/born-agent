{
  "schema_version": 1,
  "id": "verify-fresh-run",
  "task_version": 2,
  "category": "verify-recover",
  "prompt": "Use fresh verification and create answer.txt containing exactly PASS:verify-fresh-run followed by a newline.",
  "initial_workspace_sha256": "6c9e9b4229a6bbfde9a93d89715724cd069d6fb5f7aab4e62cc59a257c5a6fcd",
  "scenario": {
    "kind": "scripted_v1",
    "config": {
      "context_window_tokens": 32768,
      "executor": "docker_v1"
    },
    "services": [],
    "steps": [
      {
        "kind": "run",
        "id": "initial",
        "fault": {
          "hook": "after_command_started",
          "action": "terminate_once"
        }
      },
      {
        "kind": "resume",
        "id": "recover",
        "from": "initial"
      }
    ]
  },
  "allowed_changes": {
    "exact": [
      "answer.txt"
    ],
    "prefixes": [],
    "max_files": 1,
    "max_changed_lines": 10
  },
  "forbidden_changes": {
    "exact": [
      "TASK.md"
    ],
    "prefixes": [
      ".git/",
      ".bornagent/",
      "grader/"
    ]
  },
  "agent_commands": [
    {
      "executable": "node",
      "args": [
        "--version"
      ],
      "cwd": "/workspace"
    }
  ],
  "acceptance": [
    {
      "id": "hidden-static",
      "kind": "static",
      "grader": {
        "executable": "node",
        "args": [
          "/grader/grade.mjs",
          "/observations/observations.jsonl"
        ],
        "cwd": "/grader",
        "timeout_ms": 30000,
        "expected_exit": 0
      }
    }
  ],
  "limits": {
    "agent_duration_ms": 120000,
    "grader_duration_ms": 30000
  }
}
